# Online PostgreSQL (Neon / Vercel Postgres-compatible connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin password used on /admin
ADMIN_PASSWORD=change-me

# Long random secret (32+ characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob
# Vercel may provide OIDC automatically after the Blob store is connected.
# For local development, pull the project environment with: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
